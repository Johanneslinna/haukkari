{
  "name": "haukkari",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "content:validate": "node scripts/validate-training-content.mjs --generate && node scripts/verify-training-content.mjs",
    "content:seed": "node scripts/seed-training-content.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:test": "node scripts/verify-pwa-build.mjs",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "typecheck": "tsc -b",
    "unit": "vitest run --config vitest.unit.config.ts",
    "audit:p0": "vitest run --config vitest.unit.config.ts src/domain/coaching/P0SafetyAudit.unit.test.ts && node scripts/audits/p0-property-audit.mjs",
    "audit:p1-strength": "vitest run --config vitest.unit.config.ts src/domain/coaching/AdultResistanceEngine.unit.test.ts src/domain/coaching/SevereDomsIntegration.unit.test.ts src/domain/coaching/VerifiedNextLoad.unit.test.ts src/features/coaching/coachingActions.unit.test.ts src/features/workout/WorkoutPage.history.unit.test.ts && node scripts/audits/p1-cold-start-progression-audit.mjs",
    "audit:p1-return": "vitest run --config vitest.unit.config.ts src/domain/coaching/ReturnToStrengthPolicy.unit.test.ts src/domain/coaching/ReturnToStrengthIntegration.unit.test.ts src/features/workout/WorkoutPage.history.unit.test.ts && node scripts/audits/p1-return-to-strength-audit.mjs",
    "audit:p1-week": "vitest run --config vitest.unit.config.ts src/domain/coaching/StrengthWeekPolicy.unit.test.ts src/features/week/StrengthWeekProductionPath.unit.test.ts && node scripts/audits/p1-strength-week-audit.mjs",
    "audit:time": "vitest run --config vitest.unit.config.ts src/domain/coaching/TimeBudgetPolicy.unit.test.ts && node scripts/audits/time-budget-examples.mjs",
    "integration": "vitest run --config vitest.integration.config.ts",
    "privacy:test": "node scripts/verify-phase5-privacy.mjs",
    "test:skip-audit": "node scripts/verify-e2e-skips.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:list": "playwright test --list",
    "e2e:app": "node scripts/run-app-e2e.mjs",
    "test": "npm run unit && npm run integration",
    "check": "npm run content:validate && npm run test:skip-audit && npm run lint && npm run format-check && npm run typecheck && npm run test && npm run audit:time && npm run audit:p0 && npm run audit:p1-strength && npm run audit:p1-return && npm run audit:p1-week && npm run privacy:test && npm run build && npm run pwa:test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test-api": "node scripts/verify-local-rls.mjs",
    "db:test-sync": "node scripts/run-local-sync-test.mjs",
    "db:test-sync-e2e": "node scripts/run-local-sync-e2e.mjs",
    "db:test-delete-account": "node scripts/verify-account-deletion.mjs",
    "db:test-reminders": "node scripts/verify-reminder-dispatch.mjs",
    "db:types": "supabase gen types --lang typescript --local --schema public > src/infrastructure/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.5",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
