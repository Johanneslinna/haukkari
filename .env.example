# Frontendissä saa olla vain Supabasen julkinen URL ja anon-avain.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Web Push on oletuksena pois käytöstä. Julkinen VAPID-avain saa olla selaimessa.
VITE_ENABLE_WEB_PUSH=false
VITE_VAPID_PUBLIC_KEY=

# Harjoittelumoottori v2 ja jääkiekkoprofiili ovat oletuksena suljettuja betoja.
# Jääkiekko avautuu vain, kun molemmat liput ovat true.
VITE_TRAINING_ENGINE_V2=false
VITE_HOCKEY_BETA=false

# Tietosuojan pakolliset julkaisuarvot. Käytä rekisterinpitäjän virallista nimeä
# (ei pelkkää brändinimeä) ja valvottua sähköposti- tai muuta yhteysosoitetta.
VITE_DATA_CONTROLLER_NAME=
VITE_PRIVACY_CONTACT=

# Edge Function -salaisuudet asetetaan Supabasen secret-varastoon, ei tähän tiedostoon.
# Tuotannossa APP_PUBLIC_URL on täsmälleen https://haukkari.fi.
# APP_PUBLIC_URL=https://haukkari.fi
# SUPABASE_SERVICE_ROLE_KEY=never-place-this-in-a-VITE-variable
# VAPID_PRIVATE_KEY=never-place-this-in-a-VITE-variable
